{
  "name": "openapi-spec-scorer",
  "version": "1.0.0",
  "description": "Customizable OpenAPI specification scoring framework built on Spectral",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example": "ts-node examples/run-example.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev:api": "ts-node src/api/server.ts",
    "start": "node dist/api/server.js"
  },
  "dependencies": {
    "@stoplight/spectral-core": "^1.19.0",
    "@stoplight/spectral-rulesets": "^1.20.0",
    "@stoplight/spectral-ruleset-bundler": "^1.6.0",
    "@stoplight/spectral-runtime": "^1.1.0",
    "@stoplight/spectral-parsers": "^1.0.4",
    "@stoplight/spectral-functions": "^1.9.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
}
